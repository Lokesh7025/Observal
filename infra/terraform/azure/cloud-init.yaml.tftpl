#cloud-config
# SPDX-FileCopyrightText: 2026 Tanvi Reddy
# SPDX-License-Identifier: Apache-2.0
package_update: true
package_upgrade: true

packages:
  - docker.io
  - docker-compose-v2

write_files:
  - path: /opt/observal/docker-compose.yml
    content: |
      services:
        telemetry:
          # Dedicated single-writer DuckDB telemetry service (one process).
          image: ${telemetry_image}
          container_name: observal-telemetry
          command: ["/app/.venv/bin/python", "-m", "telemetry_store"]
          restart: unless-stopped
          ports:
            - "8125:8125"
          environment:
            TELEMETRY_DB_PATH: /data/telemetry/observal.duckdb
            TELEMETRY_TEMP_DIR: /data/telemetry/tmp
            TELEMETRY_EXPORT_DIR: /data/telemetry/exports
            TELEMETRY_BIND: 0.0.0.0:8125
            TELEMETRY_TOKEN: ${telemetry_token}
            TELEMETRY_MEMORY_LIMIT: 1536MB
            TELEMETRY_THREADS: "4"
          volumes:
            - /data/telemetry:/data/telemetry
          healthcheck:
            test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8125/v1/health')\""]
            interval: 10s
            timeout: 5s
            retries: 10
            start_period: 30s
          deploy:
            resources:
              limits:
                memory: 2G
%{ if enable_legacy_clickhouse }

        clickhouse:
          # Legacy ClickHouse for the one-time cutover. Remove enable_legacy_clickhouse afterwards.
          image: clickhouse/clickhouse-server:25.6
          container_name: observal-clickhouse
          restart: unless-stopped
          ports:
            - "8123:8123"
          environment:
            CLICKHOUSE_DB: ${clickhouse_db}
            CLICKHOUSE_USER: default
            CLICKHOUSE_PASSWORD: ${clickhouse_password}
            MAX_SERVER_MEMORY_USAGE_RATIO: "0.5"
          volumes:
            - /data/clickhouse:/var/lib/clickhouse
          deploy:
            resources:
              limits:
                memory: 3G
%{ endif }

        redis:
          image: redis:7-alpine
          restart: unless-stopped
          ports:
            - "6379:6379"
          command: redis-server --maxmemory 512mb --maxmemory-policy volatile-lru --appendonly yes
          volumes:
            - /data/redis:/data
          deploy:
            resources:
              limits:
                memory: 768M
%{ if observability_prometheus_enabled }

        prometheus:
          image: prom/prometheus:v3.12.0
          restart: unless-stopped
          ports:
            - "9090:9090"
          volumes:
            - /opt/observal/prometheus.yml:/etc/prometheus/prometheus.yml:ro
            - /data/prometheus:/prometheus
          deploy:
            resources:
              limits:
                memory: 512M
%{ endif }

%{ if observability_prometheus_enabled }
  - path: /opt/observal/prometheus.yml
    content: |
      global:
        scrape_interval: 15s
      scrape_configs:
        - job_name: observal-telemetry
          metrics_path: /metrics
          authorization:
            type: Bearer
            credentials: ${telemetry_token}
          static_configs:
            - targets: ["telemetry:8125"]
%{ endif }

runcmd:
  # Format and mount data disk
  - |
    if ! blkid /dev/sdc; then
      mkfs.ext4 /dev/sdc
    fi
    mkdir -p /data
    mount /dev/sdc /data
    echo '/dev/sdc /data ext4 defaults,nofail 0 2' >> /etc/fstab
  - mkdir -p /data/telemetry /data/telemetry/backups /data/redis
  - chown -R 1001:1001 /data/telemetry
%{ if enable_legacy_clickhouse }
  - mkdir -p /data/clickhouse
%{ endif }
%{ if observability_prometheus_enabled }
  - mkdir -p /data/prometheus
%{ endif }
  - systemctl enable docker
  - systemctl start docker
  - cd /opt/observal && docker compose up -d
