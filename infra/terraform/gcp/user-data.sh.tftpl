#!/bin/bash
# SPDX-FileCopyrightText: 2026 Lokesh Selvam <lokeshselvam7025@gmail.com>
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail

# Format and mount the data disk
DATA_DEVICE="/dev/disk/by-id/google-data-disk"
DATA_DIR="/data"
if ! blkid "$${DATA_DEVICE}"; then
  mkfs.ext4 -m 0 -E lazy_itable_init=0,lazy_journal_init=0 "$${DATA_DEVICE}"
fi
mkdir -p "$${DATA_DIR}"
mount -o discard,defaults "$${DATA_DEVICE}" "$${DATA_DIR}"
echo "UUID=$(blkid -s UUID -o value $${DATA_DEVICE}) $${DATA_DIR} ext4 discard,defaults,nofail 0 2" >> /etc/fstab

mkdir -p "$${DATA_DIR}/telemetry" "$${DATA_DIR}/telemetry/backups"
chown -R 1001:1001 "$${DATA_DIR}/telemetry" || true   # appuser inside the observal-api image
%{ if enable_legacy_clickhouse }
mkdir -p "$${DATA_DIR}/clickhouse"
%{ endif }
%{ if observability_grafana_enabled }
mkdir -p "$${DATA_DIR}/grafana"
%{ endif }
%{ if observability_prometheus_enabled }
mkdir -p "$${DATA_DIR}/prometheus"
%{ endif }

# Install Docker (COS has Docker pre-installed, but ensure compose plugin)
DOCKER_COMPOSE_VERSION="v2.36.0"
mkdir -p /usr/libexec/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/$${DOCKER_COMPOSE_VERSION}/docker-compose-$(uname -s)-$(uname -m)" \
  -o /usr/libexec/docker/cli-plugins/docker-compose
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

# Write docker-compose for the data stack
cat > "$${DATA_DIR}/docker-compose.yml" <<'COMPOSE'
services:
  telemetry:
    # Dedicated single-writer DuckDB telemetry service (one process).
    image: ${telemetry_image}
    container_name: observal-telemetry
    command: ["/app/.venv/bin/python", "-m", "telemetry_store"]
    restart: unless-stopped
    ports:
      - "8125:8125"
    environment:
      TELEMETRY_DB_PATH: /data/telemetry/observal.duckdb
      TELEMETRY_TEMP_DIR: /data/telemetry/tmp
      TELEMETRY_EXPORT_DIR: /data/telemetry/exports
      TELEMETRY_BIND: 0.0.0.0:8125
      TELEMETRY_TOKEN: ${telemetry_token}
      TELEMETRY_MEMORY_LIMIT: 1536MB
      TELEMETRY_THREADS: "4"
    volumes:
      - /data/telemetry:/data/telemetry
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8125/v1/health')\""]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s

%{ if enable_legacy_clickhouse }
  clickhouse:
    # Legacy ClickHouse for the one-time cutover. Remove enable_legacy_clickhouse afterwards.
    image: clickhouse/clickhouse-server:26.5
    container_name: observal-clickhouse
    restart: unless-stopped
    ports:
      - "8123:8123"
    environment:
      CLICKHOUSE_DB: ${clickhouse_db}
      CLICKHOUSE_PASSWORD: ${clickhouse_password}
      MAX_SERVER_MEMORY_USAGE_RATIO: "0.5"
    volumes:
      - /data/clickhouse:/var/lib/clickhouse
    healthcheck:
      test: ["CMD-SHELL", "clickhouse-client --password ${clickhouse_password} --query 'SELECT 1'"]
      interval: 10s
      timeout: 5s
      retries: 5
%{ endif }

%{ if observability_grafana_enabled }
  grafana:
    image: grafana/grafana-oss:11.6.5
    restart: unless-stopped
    ports:
      - "3000:3000"
    environment:
      GF_SECURITY_ADMIN_USER: ${grafana_admin_user}
      GF_SECURITY_ADMIN_PASSWORD: ${telemetry_token}
      GF_SERVER_ROOT_URL: "${grafana_root_url}/grafana"
      GF_SERVER_SERVE_FROM_SUB_PATH: "true"
      GF_INSTALL_PLUGINS: yesoreyeram-infinity-datasource
      TELEMETRY_URL: http://telemetry:8125
      TELEMETRY_TOKEN: ${telemetry_token}
    volumes:
      - /data/grafana:/var/lib/grafana
    depends_on:
      telemetry:
        condition: service_healthy
%{ endif }
%{ if observability_prometheus_enabled }
  prometheus:
    image: prom/prometheus:v3.11.3
    restart: unless-stopped
    ports:
      - "9090:9090"
    volumes:
      - /data/prometheus:/prometheus
      - /data/prometheus.yml:/etc/prometheus/prometheus.yml:ro
%{ endif }
COMPOSE

%{ if observability_prometheus_enabled }
# Write prometheus config
cat > "$${DATA_DIR}/prometheus.yml" <<'PROM'
global:
  scrape_interval: 30s
  evaluation_interval: 30s

scrape_configs:
  - job_name: telemetry
    static_configs:
      - targets: ["telemetry:8125"]
    authorization:
      type: Bearer
      credentials: ${telemetry_token}
PROM

%{ endif }
# Start the data stack
cd "$${DATA_DIR}"
docker compose up -d

# Set up daily telemetry store snapshot to GCS. The store copies its database
# online (snapshot-consistent) through its own backup job.
cat > /etc/cron.daily/telemetry-backup <<'CRON'
#!/bin/bash
set -euo pipefail
TS=$(date -u +%Y%m%dT%H%M%SZ)
SNAPSHOT="/data/telemetry/backups/$TS.duckdb"
docker exec observal-telemetry /app/.venv/bin/python -m telemetry_store.backup "$SNAPSHOT"
gsutil -q cp "$SNAPSHOT" "gs://${backups_bucket}/telemetry/$TS.duckdb"
find /data/telemetry/backups/ -name '*.duckdb' -mtime +${data_retention_days} -delete
CRON
chmod +x /etc/cron.daily/telemetry-backup
