#!/bin/bash
# SPDX-FileCopyrightText: 2026 Apoorv Garg <apoorvgarg.21@gmail.com>
# SPDX-License-Identifier: Apache-2.0

set -eo pipefail

# Bootstrap the data tier host: the DuckDB telemetry store plus optional observability via docker compose.
# Legacy ClickHouse also runs here while enable_legacy_clickhouse = true (cutover window).
# api/web/worker run on ECS Fargate — they are NOT started here.

exec > >(tee /var/log/observal-bootstrap.log | logger -t observal-bootstrap -s 2>/dev/console) 2>&1
echo "Observal data-host bootstrap starting at $(date -u)"

# ── Packages ─────────────────────────────────────────────────────
dnf -y update
dnf -y install docker jq awscli amazon-cloudwatch-agent
systemctl enable --now docker

# Compose v2 plugin (pinned version — do not use releases/latest)
DOCKER_COMPOSE_VERSION="v2.35.1"
mkdir -p /usr/libexec/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/$${DOCKER_COMPOSE_VERSION}/docker-compose-$(uname -s)-$(uname -m)" \
  -o /usr/libexec/docker/cli-plugins/docker-compose
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

# ── Mount /data on the EBS volume ────────────────────────────────
DEVICE=""
for d in /dev/nvme1n1 /dev/xvdf /dev/sdf; do
  if [ -b "$d" ]; then DEVICE="$d"; break; fi
done
if [ -z "$DEVICE" ]; then
  echo "Data volume not found"; exit 1
fi
if ! blkid "$DEVICE" >/dev/null 2>&1; then
  mkfs.ext4 -F "$DEVICE"
fi
mkdir -p /data
UUID=$(blkid -s UUID -o value "$DEVICE")
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID /data ext4 defaults,nofail 0 2" >> /etc/fstab
mount -a
mkdir -p /data/telemetry
%{ if enable_legacy_clickhouse }
mkdir -p /data/clickhouse
%{ endif }
%{ if observability_grafana_enabled }
mkdir -p /data/grafana
%{ endif }
%{ if observability_prometheus_enabled }
mkdir -p /data/prometheus
%{ endif }
chown -R 1001:1001 /data/telemetry || true   # appuser inside the observal-api image
%{ if enable_legacy_clickhouse }
chown -R 101:101 /data/clickhouse  || true   # clickhouse user inside the official image
%{ endif }
%{ if observability_grafana_enabled }
chown -R 472:472 /data/grafana     || true   # grafana user
%{ endif }
%{ if observability_prometheus_enabled }
chown -R 65534:65534 /data/prometheus || true # nobody
%{ endif }

# ── Pull secrets from SSM ────────────────────────────────────────
# Disable xtrace here so secrets are not echoed to CloudWatch logs (SEC-020).
set +x
fetch() { aws ssm get-parameter --with-decryption --name "$1" --region "${region}" --query Parameter.Value --output text; }

TELEMETRY_TOKEN=$(fetch "${ssm_prefix}/TELEMETRY_TOKEN")
%{ if enable_legacy_clickhouse }
CLICKHOUSE_PASSWORD=$(fetch "${ssm_prefix}/CLICKHOUSE_PASSWORD")
%{ endif }
%{ if observability_grafana_enabled }
GRAFANA_ADMIN_PASSWORD=$(fetch "${ssm_prefix}/GRAFANA_ADMIN_PASSWORD")
%{ endif }
set -x  # re-enable tracing for non-sensitive operations

# ── CloudWatch agent (ship docker logs + system logs) ────────────
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<EOF
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/observal-bootstrap.log", "log_group_name": "${log_group}", "log_stream_name": "bootstrap" },
          { "file_path": "/var/log/messages", "log_group_name": "${log_group}", "log_stream_name": "messages" }
        ]
      }
    }
  }
}
EOF
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json

# ── Fetch the upstream docker config bundle (CH config.d, Grafana provisioning) ──
INSTALL_DIR=/opt/observal
mkdir -p "$INSTALL_DIR"
cd "$INSTALL_DIR"

TARBALL_URL="https://github.com/Observal/Observal/releases/download/v${image_tag}/observal-server-v${image_tag}.tar.gz"
TARBALL_OK=false
if [ "${image_tag}" != "latest" ]; then
  for attempt in 1 2 3 4 5; do
    if curl -fsSL "$TARBALL_URL" -o /tmp/observal.tgz; then
      tar -xzf /tmp/observal.tgz --strip-components=1
      rm /tmp/observal.tgz
      TARBALL_OK=true
      break
    fi
    echo "Tarball download attempt $attempt failed, retrying in 10s..."
    sleep 10
  done
fi
if [ "$TARBALL_OK" = "false" ]; then
  echo "Using embedded configs (tarball skipped or unavailable)."
fi

%{ if enable_legacy_clickhouse }
# ── Ensure critical ClickHouse configs exist (embedded fallback) ───────
# These are written unconditionally so bootstrapping succeeds even if the
# tarball download fails (e.g. private repo, missing release, network issue).
mkdir -p "$INSTALL_DIR/docker/clickhouse/config.d"
mkdir -p "$INSTALL_DIR/docker/clickhouse/users.d"

cat > "$INSTALL_DIR/docker/clickhouse/config.d/memory.xml" <<'CHCFG'
<clickhouse>
    <listen_host>::</listen_host>
    <listen_host>0.0.0.0</listen_host>
    <listen_try>1</listen_try>
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>
    <merge_tree>
        <parts_to_delay_insert>200</parts_to_delay_insert>
        <parts_to_throw_insert>500</parts_to_throw_insert>
        <max_bytes_to_merge_at_max_space_in_pool>5368709120</max_bytes_to_merge_at_max_space_in_pool>
    </merge_tree>
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </query_log>
    <trace_log>
        <database>system</database>
        <table>trace_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <ttl>event_date + INTERVAL 1 DAY</ttl>
    </trace_log>
    <text_log>
        <database>system</database>
        <table>text_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <ttl>event_date + INTERVAL 1 DAY</ttl>
    </text_log>
    <metric_log>
        <database>system</database>
        <table>metric_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <ttl>event_date + INTERVAL 1 DAY</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <database>system</database>
        <table>asynchronous_metric_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <ttl>event_date + INTERVAL 1 DAY</ttl>
    </asynchronous_metric_log>
    <part_log>
        <database>system</database>
        <table>part_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <ttl>event_date + INTERVAL 1 DAY</ttl>
    </part_log>
</clickhouse>
CHCFG

cat > "$INSTALL_DIR/docker/clickhouse/users.d/default-user.xml" <<CHUSER
<clickhouse>
  <users>
    <default remove="remove"></default>
    <default>
      <profile>default</profile>
      <networks><ip>::/0</ip></networks>
      <password><![CDATA[$${CLICKHOUSE_PASSWORD}]]></password>
      <quota>default</quota>
      <access_management>0</access_management>
    </default>
  </users>
</clickhouse>
CHUSER

cat > "$INSTALL_DIR/docker/clickhouse/users.d/memory.xml" <<'CHPROF'
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>400000000</max_memory_usage>
            <max_bytes_before_external_group_by>200000000</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>200000000</max_bytes_before_external_sort>
            <max_bytes_in_join>100000000</max_bytes_in_join>
            <join_algorithm>auto</join_algorithm>
            <async_insert>1</async_insert>
            <wait_for_async_insert>0</wait_for_async_insert>
            <async_insert_max_data_size>1048576</async_insert_max_data_size>
            <async_insert_busy_timeout_ms>200</async_insert_busy_timeout_ms>
        </default>
    </profiles>
</clickhouse>
CHPROF
%{ endif }

# ── Render the data-tier compose file ──
cat > "$INSTALL_DIR/docker-compose.data.yml" <<'COMPOSE'
services:
  telemetry:
    # Dedicated single-writer DuckDB telemetry service (one process).
    image: $${TELEMETRY_IMAGE}
    container_name: observal-telemetry
    command: ["/app/.venv/bin/python", "-m", "telemetry_store"]
    restart: unless-stopped
    ports:
      - "8125:8125"
    environment:
      TELEMETRY_DB_PATH: /data/telemetry/observal.duckdb
      TELEMETRY_TEMP_DIR: /data/telemetry/tmp
      TELEMETRY_EXPORT_DIR: /data/telemetry/exports
      TELEMETRY_BIND: 0.0.0.0:8125
      TELEMETRY_TOKEN: $${TELEMETRY_TOKEN}
      TELEMETRY_MEMORY_LIMIT: $${TELEMETRY_MEMORY_LIMIT}
      TELEMETRY_THREADS: "4"
    volumes:
      - /data/telemetry:/data/telemetry
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8125/v1/health')\""]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s

%{ if enable_legacy_clickhouse }
  clickhouse:
    # Legacy ClickHouse for the one-time cutover. Remove enable_legacy_clickhouse afterwards.
    image: clickhouse/clickhouse-server:26.6
    container_name: observal-clickhouse
    restart: unless-stopped
    ports:
      - "8123:8123"
      - "9000:9000"
    environment:
      CLICKHOUSE_DB: $${CLICKHOUSE_DB}
      CLICKHOUSE_USER: default
      CLICKHOUSE_PASSWORD: $${CLICKHOUSE_PASSWORD}
      MAX_SERVER_MEMORY_USAGE_RATIO: "0.5"
    volumes:
      - /data/clickhouse:/var/lib/clickhouse
      - ./docker/clickhouse/config.d:/etc/clickhouse-server/config.d:ro
      - ./docker/clickhouse/users.d:/etc/clickhouse-server/users.d
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:8123/ping"]
      interval: 10s
      timeout: 5s
      retries: 5
%{ endif }

%{ if observability_grafana_enabled }
  grafana:
    image: grafana/grafana-oss:11.6.5
    container_name: observal-grafana
    restart: unless-stopped
    ports:
      - "3001:3000"
    environment:
      GF_SECURITY_ADMIN_USER: $${GRAFANA_ADMIN_USER}
      GF_SECURITY_ADMIN_PASSWORD: $${GRAFANA_ADMIN_PASSWORD}
      GF_INSTALL_PLUGINS: yesoreyeram-infinity-datasource
      GF_SERVER_ROOT_URL: $${GRAFANA_ROOT_URL}$${GRAFANA_SUBPATH_PREFIX}
      GF_SERVER_SERVE_FROM_SUB_PATH: "true"
      TELEMETRY_URL: http://observal-telemetry:8125
      TELEMETRY_TOKEN: $${TELEMETRY_TOKEN}
    volumes:
      - /data/grafana:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
    depends_on:
      telemetry:
        condition: service_healthy
%{ endif }
%{ if observability_prometheus_enabled }
  prometheus:
    image: prom/prometheus:v3.11.3
    container_name: observal-prometheus
    restart: unless-stopped
    ports:
      - "9090:9090"
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - /data/prometheus:/prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=15d
%{ endif }
COMPOSE

# Render the .env consumed by docker-compose
TELEMETRY_IMAGE="${image_repo_telemetry}:${image_tag}"
TOTAL_MEM_MB=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo)
TELEMETRY_MEMORY_LIMIT="$(( TOTAL_MEM_MB * 6 / 10 ))MB"
cat > "$INSTALL_DIR/.env" <<EOF
TELEMETRY_IMAGE=$${TELEMETRY_IMAGE}
TELEMETRY_TOKEN=$${TELEMETRY_TOKEN}
TELEMETRY_MEMORY_LIMIT=$${TELEMETRY_MEMORY_LIMIT}
%{ if enable_legacy_clickhouse }
CLICKHOUSE_DB=${clickhouse_db}
CLICKHOUSE_PASSWORD=$${CLICKHOUSE_PASSWORD}
%{ endif }
%{ if observability_grafana_enabled }
GRAFANA_ADMIN_USER=${grafana_admin_user}
GRAFANA_ADMIN_PASSWORD=$${GRAFANA_ADMIN_PASSWORD}
GRAFANA_ROOT_URL=${grafana_root_url}
GRAFANA_SUBPATH_PREFIX=${grafana_subpath_prefix}
%{ endif }
EOF
chmod 600 "$INSTALL_DIR/.env"

# ── Start ────────────────────────────────────────────────────────
cd "$INSTALL_DIR"

%{ if enable_legacy_clickhouse }
# Clear stale preprocessed configs from previous ClickHouse versions
rm -rf /data/clickhouse/preprocessed_configs
%{ endif }

%{ if observability_prometheus_enabled }
# Create prometheus.yml because compose bind-mounts it.
cat > "$INSTALL_DIR/prometheus.yml" <<'PROM'
global:
  scrape_interval: 30s
scrape_configs:
  - job_name: observal-telemetry
    static_configs:
      - targets: ['localhost:8125']
    authorization:
      type: Bearer
      credentials: $${TELEMETRY_TOKEN}
PROM

%{ endif }
docker compose --env-file "$INSTALL_DIR/.env" -f docker-compose.data.yml pull
docker compose --env-file "$INSTALL_DIR/.env" -f docker-compose.data.yml up -d

# Wait for the telemetry store to become healthy before declaring bootstrap done
echo "Waiting for telemetry store HTTP interface..."
for i in $(seq 1 30); do
  if curl -fsS http://localhost:8125/v1/health >/dev/null 2>&1; then
    echo "Telemetry store healthy after $i attempts"
    break
  fi
  if [ "$i" -eq 30 ]; then
    echo "ERROR: telemetry store did not become healthy within 5 minutes"
    docker compose -f docker-compose.data.yml logs telemetry | tail -50
    exit 1
  fi
  sleep 10
done

# ── Daily telemetry store snapshot to S3 ────────────────────────
# The store copies its database online (snapshot-consistent) via its own
# backup job; we then ship the file to S3 with the instance IAM role.
cat > /usr/local/bin/observal-telemetry-backup.sh <<'BACKUP'
#!/bin/bash
set -euo pipefail
TS=$(date -u +%Y%m%dT%H%M%SZ)
SNAPSHOT="/data/telemetry/backups/$TS.duckdb"
docker exec observal-telemetry /app/.venv/bin/python -m telemetry_store.backup "$SNAPSHOT"
aws s3 cp "$SNAPSHOT" "s3://${backups_bucket}/telemetry/$TS.duckdb" --quiet
rm -f "$SNAPSHOT"
# Keep the two most recent local snapshots only.
ls -1t /data/telemetry/backups/*.duckdb 2>/dev/null | tail -n +3 | xargs -r rm -f
BACKUP
chmod +x /usr/local/bin/observal-telemetry-backup.sh
mkdir -p /data/telemetry/backups && chown 1001:1001 /data/telemetry/backups

cat > /etc/systemd/system/observal-telemetry-backup.service <<'EOF'
[Unit]
Description=Telemetry store daily snapshot to S3
After=docker.service
[Service]
Type=oneshot
ExecStart=/usr/local/bin/observal-telemetry-backup.sh
EOF

cat > /etc/systemd/system/observal-telemetry-backup.timer <<'EOF'
[Unit]
Description=Run telemetry store snapshot daily at 03:30 UTC
[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now observal-telemetry-backup.timer

echo "Observal data-host bootstrap finished at $(date -u)"
