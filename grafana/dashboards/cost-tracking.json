{
  "uid": "observal-cost-tracking",
  "title": "Observal / Cost Tracking",
  "description": "Credits and token spend by time, agent, and user.",
  "tags": [
    "observal",
    "telemetry"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "telemetry_url",
        "label": "Telemetry store URL",
        "type": "constant",
        "query": "http://observal-telemetry:8125",
        "current": {
          "text": "http://observal-telemetry:8125",
          "value": "http://observal-telemetry:8125"
        },
        "hide": 2
      },
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "custom",
        "query": "1 hour,1 day,15 minutes,5 minutes",
        "current": {
          "text": "1 hour",
          "value": "1 hour"
        },
        "options": [
          {
            "text": "1 hour",
            "value": "1 hour",
            "selected": true
          },
          {
            "text": "1 day",
            "value": "1 day",
            "selected": false
          },
          {
            "text": "15 minutes",
            "value": "15 minutes",
            "selected": false
          },
          {
            "text": "5 minutes",
            "value": "5 minutes",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Credits (Kiro)",
      "type": "stat",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT coalesce(sum(total_credits), 0) AS credits FROM session_stats_agg WHERE last_event_time >= CAST($from AS TIMESTAMP) AND last_event_time < CAST($to AS TIMESTAMP)\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Total tokens",
      "type": "stat",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT coalesce(sum(input_tokens + output_tokens + cache_read_tokens + cache_write_tokens), 0) AS tokens FROM session_stats_agg WHERE last_event_time >= CAST($from AS TIMESTAMP) AND last_event_time < CAST($to AS TIMESTAMP)\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Avg tokens per session",
      "type": "stat",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT round(coalesce(avg(input_tokens + output_tokens), 0)) AS avg_tokens FROM session_stats_agg WHERE last_event_time >= CAST($from AS TIMESTAMP) AND last_event_time < CAST($to AS TIMESTAMP)\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Credits over time",
      "type": "timeseries",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT time_bucket(CAST($bucket AS INTERVAL), last_event_time) AS time, sum(total_credits) AS credits FROM session_stats_agg WHERE last_event_time >= CAST($from AS TIMESTAMP) AND last_event_time < CAST($to AS TIMESTAMP) GROUP BY time ORDER BY time\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "credits",
              "text": "credits",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Tokens per agent",
      "type": "barchart",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT agent_id, sum(input_tokens + output_tokens) AS tokens FROM session_stats_agg WHERE agent_id <> '' AND last_event_time >= CAST($from AS TIMESTAMP) AND last_event_time < CAST($to AS TIMESTAMP) GROUP BY agent_id ORDER BY tokens DESC LIMIT 15\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Cost drivers by user",
      "type": "table",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT user_id, count(*) AS sessions, sum(total_credits) AS credits, sum(input_tokens + output_tokens) AS tokens FROM session_stats_agg WHERE last_event_time >= CAST($from AS TIMESTAMP) AND last_event_time < CAST($to AS TIMESTAMP) GROUP BY user_id ORDER BY tokens DESC LIMIT 25\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
