    {
      "id": 5,
      "title": "Audit events over time",
      "type": "timeseries",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT time_bucket(CAST($bucket AS INTERVAL), \\\"timestamp\\\") AS time, count(*) AS events FROM audit_log WHERE \\\"timestamp\\\" >= CAST($from AS TIMESTAMP) AND \\\"timestamp\\\" < CAST($to AS TIMESTAMP) GROUP BY time ORDER BY time\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "events",
              "text": "events",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
