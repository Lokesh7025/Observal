            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT count(*) AS sensitive FROM audit_log WHERE sensitivity <> 'standard' AND \\\"timestamp\\\" >= CAST($from AS TIMESTAMP) AND \\\"timestamp\\\" < CAST($to AS TIMESTAMP)\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
