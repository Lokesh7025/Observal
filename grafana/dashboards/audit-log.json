          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT action, count(*) AS events FROM audit_log WHERE \\\"timestamp\\\" >= CAST($from AS TIMESTAMP) AND \\\"timestamp\\\" < CAST($to AS TIMESTAMP) GROUP BY action ORDER BY events DESC LIMIT 12\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": []
