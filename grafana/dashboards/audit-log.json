{
  "uid": "observal-audit-log",
  "title": "Observal / Audit Log",
  "description": "Audit trail and security events from the telemetry store.",
  "tags": [
    "observal",
    "telemetry"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "telemetry_url",
        "label": "Telemetry store URL",
        "type": "constant",
        "query": "http://observal-telemetry:8125",
        "current": {
          "text": "http://observal-telemetry:8125",
          "value": "http://observal-telemetry:8125"
        },
        "hide": 2
      },
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "custom",
        "query": "1 hour,1 day,15 minutes,5 minutes",
        "current": {
          "text": "1 hour",
          "value": "1 hour"
        },
        "options": [
          {
            "text": "1 hour",
            "value": "1 hour",
            "selected": true
          },
          {
            "text": "1 day",
            "value": "1 day",
            "selected": false
          },
          {
            "text": "15 minutes",
            "value": "15 minutes",
            "selected": false
          },
          {
            "text": "5 minutes",
            "value": "5 minutes",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Audit events",
      "type": "stat",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT count(*) AS events FROM audit_log WHERE \\\"timestamp\\\" >= CAST($from AS TIMESTAMP) AND \\\"timestamp\\\" < CAST($to AS TIMESTAMP)\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Failures",
      "type": "stat",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT count(*) AS failures FROM audit_log WHERE outcome = 'failure' AND \\\"timestamp\\\" >= CAST($from AS TIMESTAMP) AND \\\"timestamp\\\" < CAST($to AS TIMESTAMP)\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
