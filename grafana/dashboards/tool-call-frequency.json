{
  "uid": "observal-tool-call-frequency",
  "title": "Observal / Tool Call Frequency",
  "description": "Which tools agents call, how often, and from which harness.",
  "tags": [
    "observal",
    "telemetry"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "telemetry_url",
        "label": "Telemetry store URL",
        "type": "constant",
        "query": "http://observal-telemetry:8125",
        "current": {
          "text": "http://observal-telemetry:8125",
          "value": "http://observal-telemetry:8125"
        },
        "hide": 2
      },
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "custom",
        "query": "1 hour,1 day,15 minutes,5 minutes",
        "current": {
          "text": "1 hour",
          "value": "1 hour"
        },
        "options": [
          {
            "text": "1 hour",
            "value": "1 hour",
            "selected": true
          },
          {
            "text": "1 day",
            "value": "1 day",
            "selected": false
          },
          {
            "text": "15 minutes",
            "value": "15 minutes",
            "selected": false
          },
          {
            "text": "5 minutes",
            "value": "5 minutes",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Tool calls",
      "type": "stat",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT count(*) AS calls FROM session_events WHERE event_type = 'tool_call' AND \\\"timestamp\\\" >= CAST($from AS TIMESTAMP) AND \\\"timestamp\\\" < CAST($to AS TIMESTAMP)\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Tool results",
      "type": "stat",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT count(*) AS results FROM session_events WHERE event_type = 'tool_result' AND \\\"timestamp\\\" >= CAST($from AS TIMESTAMP) AND \\\"timestamp\\\" < CAST($to AS TIMESTAMP)\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Distinct tools",
      "type": "stat",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT count(DISTINCT tool_name) AS tools FROM session_events WHERE event_type = 'tool_call' AND tool_name IS NOT NULL AND \\\"timestamp\\\" >= CAST($from AS TIMESTAMP) AND \\\"timestamp\\\" < CAST($to AS TIMESTAMP)\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Tool calls over time",
      "type": "timeseries",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT time_bucket(CAST($bucket AS INTERVAL), \\\"timestamp\\\") AS time, count(*) AS calls FROM session_events WHERE event_type = 'tool_call' AND \\\"timestamp\\\" >= CAST($from AS TIMESTAMP) AND \\\"timestamp\\\" < CAST($to AS TIMESTAMP) GROUP BY time ORDER BY time\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "calls",
              "text": "calls",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Most used tools",
      "type": "piechart",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT tool_name, count(*) AS calls FROM session_events WHERE event_type = 'tool_call' AND tool_name IS NOT NULL AND \\\"timestamp\\\" >= CAST($from AS TIMESTAMP) AND \\\"timestamp\\\" < CAST($to AS TIMESTAMP) GROUP BY tool_name ORDER BY calls DESC LIMIT 12\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Tools by harness",
      "type": "table",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "observal-telemetry"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "observal-telemetry"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${telemetry_url}/v1/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT harness, tool_name, count(*) AS calls FROM session_events WHERE event_type = 'tool_call' AND tool_name IS NOT NULL AND \\\"timestamp\\\" >= CAST($from AS TIMESTAMP) AND \\\"timestamp\\\" < CAST($to AS TIMESTAMP) GROUP BY harness, tool_name ORDER BY calls DESC LIMIT 100\", \"params\": {\"from\": \"${__from:date:iso}\", \"to\": \"${__to:date:iso}\", \"bucket\": \"${bucket}\"}}"
          },
          "root_selector": "rows",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
